{
  "name": "pulse-electron",
  "version": "1.0.0",
  "description": "Pulse benchmark app in Electron",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.main.json",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "build": {
    "appId": "com.pulse.electron",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*"
    ],
    "win": {
      "target": "zip"
    },
    "linux": {
      "target": "tar.gz"
    }
  }
}
