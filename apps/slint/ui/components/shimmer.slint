import { Tokens } from "../tokens.slint";

export component Shimmer {
    width: 100%;

    // Slint animation loop for shimmer
    property <duration> tick: animation-tick();
    property <float> phase: Math.mod(tick / 1ms, 1200) / 1200.0;

    VerticalLayout {
        spacing: 8px;
        for w in [100%, 80%, 60%] : Rectangle {
            width: w;
            height: 16px;
            border-radius: 4px;
            background: Tokens.active-surfaceAlt;

            // We use a pseudo shimmer by animating a child rectangle across
            clip: true;
            Rectangle {
                width: 50%; height: 100%;
                x: parent.width * (phase * 2.0 - 0.5);
                background: @linear-gradient(90deg, #ffffff00 0%, #ffffff80 50%, #ffffff00 100%);
            }
        }
    }
}
