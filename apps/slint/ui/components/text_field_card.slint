import { Tokens } from "../tokens.slint";
import { LineEdit } from "std-widgets.slint";

export component TextFieldCard {
    in-out property <string> name;

    VerticalLayout {
        spacing: 16px;

        Rectangle {
            height: 56px;
            border-radius: 14px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Tokens.active-primary : Tokens.active-outline;
            animate border-color { duration: Tokens.fast; }
            background: Tokens.active-surface;

            input := LineEdit {
                width: 100%; height: 100%;
                text <=> root.name;
                placeholder-text: "Your name";
                // Slint LineEdit doesn't have an animated floating label easily accessible,
                // we approximate it with placeholder-text for simplicity or skip floating label.
            }
        }

        Rectangle {
            // greeting
            height: 24px;
            opacity: root.name != "" ? 1.0 : 0.0;
            animate opacity { duration: Tokens.fast; }

            Text {
                text: "Hello, " + root.name;
                color: Tokens.active-text;
                font-size: Tokens.font-body;
            }
        }
    }
}
