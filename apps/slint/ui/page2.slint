import { Tokens } from "tokens.slint";
import { ItemData } from "item_data.slint";
import { ProgressRing } from "components/progress_ring.slint";
import { Accordion } from "components/accordion.slint";
import { DragCard } from "components/drag_card.slint";
import { SwipeList } from "components/swipe_list.slint";
import { Shimmer } from "components/shimmer.slint";

export component Page2 {
    in property <ItemData> item;
    callback back-tapped();

    // loading state for shimmer (1.5s approx)
    property <bool> is-loading: true;

    // We would use a timer in Rust to disable loading, but we can fake it or let Rust handle it.
    // For now let's just make a button to toggle loading.

    Flickable {
        width: 100%;
        height: 100%;

        VerticalLayout {
            alignment: start;

            // Header
            Rectangle {
                height: 240px;
                background: @linear-gradient(135deg, item.color1 0%, item.color2 100%);

                TouchArea {
                    width: 44px; height: 44px; x: 8px; y: 8px;
                    clicked => { root.back-tapped(); }
                    Text { text: "<-"; color: Tokens.active-onPrimary; horizontal-alignment: center; vertical-alignment: center; }
                }

                Text {
                    text: item.title;
                    color: Tokens.active-onPrimary;
                    font-size: Tokens.font-display;
                    font-weight: Tokens.weight-display;
                    x: 16px; y: 240px - 40px - 16px;
                }
            }

            VerticalLayout {
                padding: 16px;
                spacing: 24px;

                HorizontalLayout {
                    alignment: center;
                    ProgressRing { score: item.score; active: !root.is-loading; }
                }

                Accordion {}

                HorizontalLayout {
                    alignment: center;
                    DragCard {}
                }

                SwipeList {}

                // Buttons row
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { height: 44px; border-radius: 14px; background: Tokens.active-surface; border-width: 1px; border-color: Tokens.active-outline; HorizontalLayout{ alignment: center; Text{ text: "Dialog"; vertical-alignment: center; } } TouchArea {} }
                    Rectangle { height: 44px; border-radius: 14px; background: Tokens.active-surface; border-width: 1px; border-color: Tokens.active-outline; HorizontalLayout{ alignment: center; Text{ text: "Sheet"; vertical-alignment: center; } } TouchArea {} }
                    Rectangle { height: 44px; border-radius: 14px; background: Tokens.active-surface; border-width: 1px; border-color: Tokens.active-outline; HorizontalLayout{ alignment: center; Text{ text: "Toast"; vertical-alignment: center; } } TouchArea {} }
                }

                if root.is-loading : Shimmer {}
                if !root.is-loading : Text {
                    text: item.body;
                    color: Tokens.active-text;
                    font-size: Tokens.font-body;
                    wrap: word-wrap;
                }

                Rectangle { height: 44px; background: Tokens.active-surface; TouchArea { clicked => { root.is-loading = !root.is-loading; } } Text { text: "Toggle Loading"; horizontal-alignment: center; vertical-alignment: center; } }

                Rectangle { height: 32px; }
            }
        }
    }
}
