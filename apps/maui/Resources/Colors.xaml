<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Light Theme Tokens -->
    <Color x:Key="LightBackground">#F6F4FB</Color>
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightSurfaceAlt">#EEEAF7</Color>
    <Color x:Key="LightPrimary">#6750A4</Color>
    <Color x:Key="LightOnPrimary">#FFFFFF</Color>
    <Color x:Key="LightAccent">#FF7A59</Color>
    <Color x:Key="LightText">#1D1B20</Color>
    <Color x:Key="LightTextMuted">#6B6674</Color>
    <Color x:Key="LightOutline">#D9D3E6</Color>
    <Color x:Key="LightSuccess">#2E9E6B</Color>

    <!-- Dark Theme Tokens -->
    <Color x:Key="DarkBackground">#121016</Color>
    <Color x:Key="DarkSurface">#1C1A22</Color>
    <Color x:Key="DarkSurfaceAlt">#26232E</Color>
    <Color x:Key="DarkPrimary">#CFBCFF</Color>
    <Color x:Key="DarkOnPrimary">#381E72</Color>
    <Color x:Key="DarkAccent">#FF9E85</Color>
    <Color x:Key="DarkText">#E6E0E9</Color>
    <Color x:Key="DarkTextMuted">#A9A3B3</Color>
    <Color x:Key="DarkOutline">#3A3644</Color>
    <Color x:Key="DarkSuccess">#5FD39B</Color>

</ResourceDictionary>
