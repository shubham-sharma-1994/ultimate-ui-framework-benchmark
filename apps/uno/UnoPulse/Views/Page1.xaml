<Page x:Class="UnoPulse.Views.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UnoPulse.Views"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:UnoPulse.Models"
      mc:Ignorable="d"
      Background="{ThemeResource AppBackground}"
      RequestedTheme="Light">

  <Page.Resources>
      <DataTemplate x:Key="ItemTemplate" x:DataType="models:ItemData">
          <Grid Margin="0,0,0,16" Background="Transparent" Tapped="OnItemTapped">
              <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Border Width="56" Height="56" CornerRadius="16" Margin="0,0,16,0" x:Name="Thumbnail">
                  <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="{Binding Color1}" Offset="0" />
                          <GradientStop Color="{Binding Color2}" Offset="1" />
                      </LinearGradientBrush>
                  </Border.Background>
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource BodyTextStyle}" />
                  <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource AppTextMuted}" />
              </StackPanel>

              <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{ThemeResource AppTextMuted}" />
          </Grid>
      </DataTemplate>
  </Page.Resources>

  <Grid MaxWidth="480" HorizontalAlignment="Center" Background="{ThemeResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Height="56" Padding="16,0" Background="{ThemeResource AppSurface}" x:Name="AppBar" Canvas.ZIndex="10">
        <Grid.Shadow>
            <ThemeShadow />
        </Grid.Shadow>
        <TextBlock Text="Pulse" Style="{StaticResource TitleTextStyle}" VerticalAlignment="Center"/>
        <Button x:Name="ThemeToggle" AutomationProperties.AutomationId="theme-toggle" Click="OnThemeToggleClicked" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="8">
            <TextBlock x:Name="ThemeIcon" Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource AppText}" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="ThemeIconRotation" Angle="0"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" Padding="16" x:Name="MainScroll" ViewChanged="OnScrollViewChanged">
        <StackPanel Spacing="16" Padding="0,0,0,32">

            <Border Height="180" CornerRadius="20" Padding="16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{ThemeResource LightPrimary}" Offset="0"/>
                        <GradientStop Color="{ThemeResource LightAccent}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock Text="Same app. Every framework." Style="{StaticResource TitleTextStyle}" Foreground="White" VerticalAlignment="Top"/>

                    <Canvas x:Name="orbit" AutomationProperties.AutomationId="orbit" Width="80" Height="80" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="OrbitRotation" Angle="0"/>
                        </Canvas.RenderTransform>
                        <Ellipse Width="80" Height="80" Stroke="White" StrokeThickness="2" Opacity="0.5"/>
                        <Ellipse Width="12" Height="12" Fill="White" Canvas.Left="34" Canvas.Top="-6"/>
                        <Ellipse Width="12" Height="12" Fill="White" Canvas.Left="68" Canvas.Top="53"/>
                        <Ellipse Width="12" Height="12" Fill="White" Canvas.Left="0" Canvas.Top="53"/>
                    </Canvas>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Taps" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center" ClipToBounds="True" Height="40">
                    <TextBlock x:Name="CounterText" Text="0" Style="{StaticResource DisplayTextStyle}" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="CounterTranslate" Y="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="2" x:Name="CounterInc" AutomationProperties.AutomationId="counter-inc" Content="+" Click="OnCounterClicked" Holding="OnCounterLongPressed" Background="{ThemeResource AppPrimary}" Foreground="{ThemeResource AppOnPrimary}" CornerRadius="14" Width="44" Height="44" FontSize="20" />
            </Grid>

            <Border Background="{ThemeResource AppSurface}" CornerRadius="20" Padding="16">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="Notifications" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="NotificationsSwitch" AutomationProperties.AutomationId="switch" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OffContent="" OnContent=""/>
                    </Grid>

                    <StackPanel>
                        <TextBlock Text="{Binding ElementName=IntensitySlider, Path=Value, StringFormat='Intensity: {0}'}" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                        <Slider x:Name="IntensitySlider" AutomationProperties.AutomationId="slider" Minimum="0" Maximum="100" Value="50"/>
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="ChipLow" AutomationProperties.AutomationId="chip-low" Content="Low" CornerRadius="999" HorizontalAlignment="Stretch" Click="OnChipClicked"/>
                        <ToggleButton Grid.Column="1" x:Name="ChipMedium" AutomationProperties.AutomationId="chip-medium" Content="Medium" CornerRadius="999" HorizontalAlignment="Stretch" Click="OnChipClicked"/>
                        <ToggleButton Grid.Column="2" x:Name="ChipHigh" AutomationProperties.AutomationId="chip-high" Content="High" CornerRadius="999" HorizontalAlignment="Stretch" Click="OnChipClicked"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBox x:Name="NameInput" AutomationProperties.AutomationId="name-input" Header="Your name" CornerRadius="14" TextChanged="OnNameTextChanged"/>
                <TextBlock x:Name="GreetingText" Text="Hello, " Style="{StaticResource BodyTextStyle}" Opacity="0"/>
            </StackPanel>

            <ListView x:Name="ItemsList" ItemTemplate="{StaticResource ItemTemplate}" SelectionMode="None" IsItemClickEnabled="False" />
        </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
