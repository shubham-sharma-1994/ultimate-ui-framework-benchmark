<Page x:Class="UnoPulse.Views.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UnoPulse.Views"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource AppBackground}">

  <Grid MaxWidth="480" HorizontalAlignment="Center">
      <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid x:Name="HeaderArea" Height="240" Background="{ThemeResource AppSurface}">
          <Border x:Name="HeroThumbnail">
              <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop x:Name="HeroColor1" Offset="0" />
                      <GradientStop x:Name="HeroColor2" Offset="1" />
                  </LinearGradientBrush>
              </Border.Background>
          </Border>

          <Button x:Name="BackButton" AutomationProperties.AutomationId="back" Click="OnBackClicked" Margin="16" VerticalAlignment="Top" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0">
              <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="20"/>
          </Button>

          <TextBlock x:Name="HeaderTitle" Text="Title" Style="{StaticResource DisplayTextStyle}" Foreground="White" VerticalAlignment="Bottom" Margin="16" RenderTransformOrigin="0,1">
              <TextBlock.RenderTransform>
                  <CompositeTransform x:Name="HeaderTitleTransform"/>
              </TextBlock.RenderTransform>
          </TextBlock>
      </Grid>

      <ScrollViewer Grid.Row="1" x:Name="DetailScroll" ViewChanged="OnDetailScrollChanged" Padding="16">
          <StackPanel Spacing="16">

              <Grid Height="120" Width="120" HorizontalAlignment="Center">
                  <Path Stroke="{ThemeResource AppOutline}" StrokeThickness="12" Data="M 60,6 A 54,54 0 1,1 59.9,6"/>
                  <Path x:Name="ProgressRing" AutomationProperties.AutomationId="ring" Stroke="{ThemeResource AppPrimary}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Tapped="OnRingTapped">
                      <Path.Data>
                          <PathGeometry>
                              <PathFigure StartPoint="60,6">
                                  <ArcSegment x:Name="ProgressArc" Point="60,6" Size="54,54" SweepDirection="Clockwise" IsLargeArc="False"/>
                              </PathFigure>
                          </PathGeometry>
                      </Path.Data>
                  </Path>
                  <TextBlock x:Name="ScoreText" Text="0%" Style="{StaticResource TitleTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>

              <Border x:Name="DragCard" AutomationProperties.AutomationId="drag-card" Width="96" Height="96" Background="{ThemeResource AppAccent}" CornerRadius="16" ManipulationMode="TranslateX,TranslateY" ManipulationDelta="OnCardManipulationDelta" ManipulationCompleted="OnCardManipulationCompleted">
                  <Border.RenderTransform>
                      <TranslateTransform x:Name="DragTransform"/>
                  </Border.RenderTransform>
              </Border>

              <StackPanel x:Name="SwipeList" Spacing="8">
                  <SwipeControl x:Name="Swipe1" AutomationProperties.AutomationId="swipe-1">
                      <SwipeControl.RightItems>
                          <SwipeItems Mode="Execute">
                              <SwipeItem Text="Delete" Background="#E5484D" Invoked="OnSwipeInvoked"/>
                          </SwipeItems>
                      </SwipeControl.RightItems>
                      <Border Background="{ThemeResource AppSurface}" Padding="16" CornerRadius="8">
                          <TextBlock Text="Swipe me 1" Style="{StaticResource BodyTextStyle}"/>
                      </Border>
                  </SwipeControl>
                  <SwipeControl x:Name="Swipe2" AutomationProperties.AutomationId="swipe-2">
                      <SwipeControl.RightItems>
                          <SwipeItems Mode="Execute">
                              <SwipeItem Text="Delete" Background="#E5484D" Invoked="OnSwipeInvoked"/>
                          </SwipeItems>
                      </SwipeControl.RightItems>
                      <Border Background="{ThemeResource AppSurface}" Padding="16" CornerRadius="8">
                          <TextBlock Text="Swipe me 2" Style="{StaticResource BodyTextStyle}"/>
                      </Border>
                  </SwipeControl>
                  <SwipeControl x:Name="Swipe3" AutomationProperties.AutomationId="swipe-3">
                      <SwipeControl.RightItems>
                          <SwipeItems Mode="Execute">
                              <SwipeItem Text="Delete" Background="#E5484D" Invoked="OnSwipeInvoked"/>
                          </SwipeItems>
                      </SwipeControl.RightItems>
                      <Border Background="{ThemeResource AppSurface}" Padding="16" CornerRadius="8">
                          <TextBlock Text="Swipe me 3" Style="{StaticResource BodyTextStyle}"/>
                      </Border>
                  </SwipeControl>

                  <Button x:Name="SwipeReset" AutomationProperties.AutomationId="swipe-reset" Content="Reset" Click="OnResetSwipes" Background="Transparent" Foreground="{ThemeResource AppPrimary}" HorizontalAlignment="Center"/>
              </StackPanel>

              <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BtnDialog" AutomationProperties.AutomationId="btn-dialog" Content="Dialog" HorizontalAlignment="Stretch" Click="OnDialogClicked"/>
                  <Button Grid.Column="1" x:Name="BtnSheet" AutomationProperties.AutomationId="btn-sheet" Content="Sheet" HorizontalAlignment="Stretch" Click="OnSheetClicked"/>
                  <Button Grid.Column="2" x:Name="BtnToast" AutomationProperties.AutomationId="btn-toast" Content="Toast" HorizontalAlignment="Stretch" Click="OnToastClicked"/>
              </Grid>

              <Border x:Name="Shimmer" AutomationProperties.AutomationId="shimmer" Height="80" CornerRadius="8" Margin="0,32,0,0">
                  <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="#EEEEEE" Offset="0"/>
                          <GradientStop Color="#DDDDDD" Offset="0.5"/>
                          <GradientStop Color="#EEEEEE" Offset="1"/>
                      </LinearGradientBrush>
                  </Border.Background>
              </Border>

          </StackPanel>
      </ScrollViewer>

      <InfoBar x:Name="ToastBar" IsOpen="False" Severity="Success" Title="Toast message" VerticalAlignment="Bottom" Margin="16" Canvas.ZIndex="100"/>

  </Grid>
</Page>
